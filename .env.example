# Copy this file to .env and change the values.
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./jobtracker.db

# PostgreSQL (used by docker-compose)
# DATABASE_URL=postgresql+psycopg://jobtracker:jobtracker@db:5432/jobtracker
